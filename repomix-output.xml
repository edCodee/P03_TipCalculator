<file path="app/src/main/res/layout/activity_main.xml">
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.tipcalculator.MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/app_name"
        app:titleTextColor="?attr/colorOnPrimary" />

    <GridLayout
        android:id="@+id/tipCalculatorGridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:padding="@dimen/screen_padding"
        android:useDefaultMargins="true">

    <!-- Fila 0: el EditText va PRIMERO para quedar detras del TextView -->
        <EditText
            android:id="@+id/amountEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnSpan="2"
            android:layout_gravity="fill_horizontal"
            android:digits="0123456789"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6"
            android:minHeight="48dp"
            android:hint="@string/amount_field_label"
            android:contentDescription="@string/amount_field_label"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView
        android:id="@+id/amountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_columnSpan="2"
        android:layout_gravity="fill_horizontal"
        android:background="@color/amount_background"
        android:elevation="@dimen/view_elevation"
        android:hint="@string/enter_amount"
        android:padding="@dimen/textview_padding"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/on_colored_background"
        android:textColorHint="@color/on_colored_background"
        android:importantForAccessibility="no"
        tools:text="$56.32" />

    <!-- Fila 1: porcentaje -->
    <TextView
        android:id="@+id/percentTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_gravity="center_vertical|end"
        android:text="@string/tip_percentage"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

        <SeekBar
            android:id="@+id/percentSeekBar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/seekbar_height"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:max="30"
            android:progress="15"
            android:progressTint="?attr/colorSecondary"
            android:thumbTint="?attr/colorSecondary"
            android:contentDescription="@string/percent_seekbar_label" />


    <!-- Fila 2: propina -->
    <TextView
        android:id="@+id/tipLabelTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_gravity="center_vertical|end"
        android:text="@string/tip"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView
        android:id="@+id/tipTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_row="2"
        android:layout_column="1"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:background="@color/result_background"
        android:elevation="@dimen/view_elevation"
        android:gravity="center"
        android:padding="@dimen/textview_padding"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/on_colored_background"
        tools:text="$14.08" />

    <!-- Fila 3: total -->
    <TextView
        android:id="@+id/totalLabelTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_row="3"
        android:layout_column="0"
        android:layout_gravity="center_vertical|end"
        android:text="@string/total"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView
        android:id="@+id/totalTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_row="3"
        android:layout_column="1"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:background="@color/result_background"
        android:elevation="@dimen/view_elevation"
        android:gravity="center"
        android:padding="@dimen/textview_padding"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/on_colored_background"
        tools:text="$70.40" />

    </GridLayout>

</LinearLayout>
</file>

